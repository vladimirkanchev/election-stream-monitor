# Optional local configuration reference. This project does not auto-load .env.
# Source this file explicitly or export only the settings you need before startup.

# Safe local defaults. These match the behavior when the variables are unset.
ESM_SESSION_STORE_BACKEND=file
ESM_ALERT_STORE_BACKEND=file
ESM_FASTAPI_RUN_MODE=local

# PostgreSQL is an explicit opt-in. Set a real disposable URL in your shell or
# private .env; never commit it. Select the relevant backend before using it.
# ESM_POSTGRES_SESSION_DATABASE_URL (set privately)
# ESM_POSTGRES_SESSION_AUTO_CREATE_TABLES=1
# POSTGRES_SESSION_STORE_REAL_SMOKE=1
# ESM_POSTGRES_ALERT_DATABASE_URL (set privately)
# ESM_POSTGRES_ALERT_AUTO_CREATE_TABLES=1
# POSTGRES_ALERT_STORE_REAL_SMOKE=1

# Share mode requires API-key authentication. Do not set a blank key: omit this
# variable to let the share CLI generate one for that process, or export a real
# non-blank key privately before startup.
# ESM_API_AUTH_ALLOWED_KEYS (set privately; do not leave blank)
